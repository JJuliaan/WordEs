# Copiar a .env y completar. Ver Developer Portal -> Activities -> Settings.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Reglas de la partida (opcional, estos son los valores por defecto) ---
# MAX_INTENTOS=8
# MAX_PISTAS=3
# LONGITUD_PALABRA=5

# --- Sistema de puntos (opcional, estos son los valores por defecto) ---
# PUNTOS_POR_VERDE=10
# PUNTOS_POR_AMARILLO=5
# BONUS_VICTORIA=20
# PUNTOS_POR_INTENTO_SOBRANTE=5
# COSTO_BASE_PISTA=15

# --- Red / CORS (opcional) ---
# CORS_ALLOW_ORIGINS=*

# --- API externa de palabras aleatorias (opcional) ---
# RANDOM_WORD_API_URL=https://random-word-api.herokuapp.com/word
# RANDOM_WORD_API_INTENTOS=5
# RANDOM_WORD_API_TIMEOUT=5.0
